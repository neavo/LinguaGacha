{
  "name": "linguagacha",
  "version": "0.0.0",
  "private": true,
  "description": "Next Generation AI translator for novels, games, subtitles, and more",
  "author": "neavo",
  "type": "module",
  "main": "build/dist-electron/index.js",
  "scripts": {
    "build": "npm run typecheck && electron-vite build --config buildtools/vite/electron.vite.config.ts && node buildtools/build-workspace.mjs && node buildtools/build-pdf-print.mjs && electron-builder --config buildtools/builder/electron-builder.config.ts",
    "check": "node ./buildtools/check/index.mjs",
    "dev": "node buildtools/build-workspace.mjs && node buildtools/build-pdf-print.mjs && electron-vite dev --config buildtools/vite/electron.vite.config.ts",
    "format": "node ./buildtools/format-related-files.mjs",
    "lint": "oxlint . && oxlint --react-plugin -A all -D react/only-export-components src/frontend",
    "postinstall": "install-electron",
    "test": "vitest run --config buildtools/vitest/vitest.config.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
