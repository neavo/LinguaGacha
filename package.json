    "hono": "^4.12.32",
    "htmlparser2": "^12.0.0",
    "iconv-lite": "^0.7.3",
    "js-tiktoken": "^1.0.21",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
