{
  "name": "LinguaGacha",
  "version": "0.0.0",
  "private": true,
  "description": "Next Generation AI translator for novels, games, subtitles, and more",
  "author": "neavo",
  "type": "module",
  "main": "build/dist-electron/index.js",
  "scripts": {
    "build": "npm run typecheck && electron-vite build --config buildtools/vite/electron.vite.config.ts && node buildtools/resources/build.mjs && electron-builder --config buildtools/builder/electron-builder.config.ts",
    "check": "node ./buildtools/check/index.mjs",
    "dev": "node buildtools/resources/build.mjs --development && electron-vite dev --config buildtools/vite/electron.vite.config.ts",
    "format": "node ./buildtools/format-related-files.mjs",
    "lint": "oxlint . && oxlint --react-plugin -A all -D react/only-export-components src/frontend",
    "postinstall": "install-electron",
    "test": "vitest run --config buildtools/vitest/vitest.config.ts",
    "typecheck": "tsrs -b --fast false"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/collision": "^0.5.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@earendil-works/pi-mcp": "^1.3.0",
    "@electron/asar": "^4.3.1",
    "@floating-ui/react-dom": "^2.1.9",
    "@hono/node-server": "^2.1.6",
    "@lezer/highlight": "^1.2.5",
    "@ruby/prism": "^2.1.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.2.1",
    "ansis": "^4.5.0",
    "chardet": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "entities": "^9.0.0",
    "exceljs": "^4.4.0",
    "execa": "^10.2.1",
    "gpt-tokenizer": "^4.1.0",
    "hono": "^4.13.16",
    "htmlparser2": "^12.0.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.15",
    "jsdom": "^30.1.3",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "mupdf": "1.28.1",
    "next-themes": "^0.4.6",
    "npm": "^12.2.2",
    "oxc-parser": "^0.157.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.23.0",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tree-sitter-python": "0.25.0",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.4.4",
    "undici": "^8.12.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "web-tree-sitter": "0.27.1",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^14.0.3"
    }
  },
  "workspaceRuntimePackages": {
    "agent": [
      "chardet",
      "exceljs",
      "iconv-lite",
      "jszip",
      "remark-gfm",
      "remark-parse",
      "unified"
    ],
    "backend": [
      "@ruby/prism",
      "mupdf",
      "oxc-parser",
      "web-tree-sitter"
    ]
  },
  "workspaceRuntimeTools": {
    "uv": "0.13.7"
  }
}
