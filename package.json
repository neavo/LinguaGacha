{
  "name": "linguagacha",
  "version": "0.0.0",
  "private": true,
  "description": "Next Generation AI translator for novels, games, subtitles, and more",
  "author": "neavo",
  "type": "module",
  "main": "build/dist-electron/index.js",
  "scripts": {
    "build": "tsc -b --noEmit && electron-vite build --config buildtools/vite/electron.vite.config.ts && vite build --config buildtools/vite/deno-runtime.vite.config.ts && electron-builder --config buildtools/builder/electron-builder.config.ts",
    "check": "node ./buildtools/check/index.mjs",
    "dev": "node ./buildtools/builder/deno-runtime.mjs && vite build --config buildtools/vite/deno-runtime.vite.config.ts && electron-vite dev --config buildtools/vite/electron.vite.config.ts",
    "format": "node ./buildtools/format-related-files.mjs",
    "lint": "oxlint .",
    "postinstall": "node ./node_modules/electron/install.js",
    "test": "vitest run --config buildtools/vitest/vitest.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
