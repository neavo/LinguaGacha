{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node", "vite/client"],
    "tsBuildInfoFile": "./build/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "buildtools/**/*.ts",
    "src/backend",
    "src/cli",
    "src/domain",
    "src/electron-env.d.ts",
    "src/gui",
    "src/index.ts",
    "src/native",
    "src/shared"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test"]
}
