{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "./build/tsconfig.renderer.tsbuildinfo"
  },
  "include": [
    "src/backend/api/api-base-url.ts",
    "src/domain",
    "src/frontend",
    "src/gui/bridge/*.ts",
    "src/gui/gui-ipc-contract.ts",
    "src/gui/shell/external-url-policy.ts",
    "src/gui/shell/shell-contract.ts",
    "src/shared"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test"]
}
